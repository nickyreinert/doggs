# Storage paths (absolute paths are best for a systemd deployment)
INCOMING_DIR=./incoming
ARCHIVE_DIR=./archive
DATA_DIR=./data
CSV_PATH=./data/index.csv
ERROR_DIR=./errors
DUPLICATE_DIR=./duplicates

# Web server
HOST=0.0.0.0
PORT=8383

# Scanner and OCR
POLL_SECONDS=300
OCR_LANG=eng
OCR_DPI=200
TOP_REGION_FRACTION=0.25
HEAD_PAGES=2
OCR_TRIGGER_CHARS=80

# Local Ollama metadata extraction
AI_MODE=ollama
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:3b
AI_TIMEOUT=60
MAX_TEXT_CHARS=300
