# Storage paths (absolute paths are best for a systemd deployment)
INCOMING_DIR=./incoming
ARCHIVE_DIR=./archive
DATA_DIR=./data
CSV_PATH=./data/index.csv
ERROR_DIR=./errors
DUPLICATE_DIR=./duplicates
TRASH_DIR=./trash

# Web server
HOST=0.0.0.0
PORT=8383

# Scanner and OCR
POLL_SECONDS=300
# Scan only PDFs directly in INCOMING_DIR. Set to 1 for subfolders.
RECURSIVE_SCAN=0
# Multiple languages use Tesseract's plus syntax, for example deu+eng.
OCR_LANG=eng
OCR_DPI=200
TOP_REGION_FRACTION=0.25
HEAD_PAGES=2
OCR_TRIGGER_CHARS=80

# Local Ollama metadata extraction
AI_MODE=ollama
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:1.5b
AI_TIMEOUT=60
MAX_TEXT_CHARS=300

# External API / MCP server (disabled until a token is set)
# EXTERNAL_API_TOKEN=generate-a-long-random-value
# Full-text + semantic search index (local cache, rebuilt automatically)
EMBED_MODEL=jina/jina-embeddings-v2-base-de
# SEARCH_DB_PATH=./cache/search.sqlite
SEARCH_OCR_PAGES=3

# Optional visual Office previews (LibreOffice is detected automatically)
# LIBREOFFICE_BIN=/usr/bin/libreoffice
# PREVIEW_DIR=./cache/previews
